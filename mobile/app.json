{
    "expo": {
        "name": "FitVerse",
        "slug": "fitverse",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/fit-verse-logo.png",
        "scheme": "fitverse",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "extra": {
            "mode": "production",
            "router": {},
            "eas": {
                "projectId": "c75ee23b-09fd-49b9-9de4-7686ee4be445"
            }
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.xjohnfitcodes.fitverseapp",
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "package": "com.xjohnfitcodes.fitverseapp",
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "",
                "backgroundImage": "",
                "monochromeImage": ""
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "permissions": [
                "android.permission.RECEIVE_BOOT_COMPLETED",
                "android.permission.VIBRATE"
            ]
        },
        "web": {
            "output": "static",
            "favicon": "./assets/fit-verse-logo-no-bg.png",
            "bundler": "metro"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/fit-verse-logo-no-bg.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ],
            "expo-web-browser"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
